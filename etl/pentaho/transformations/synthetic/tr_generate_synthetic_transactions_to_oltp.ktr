    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${BI_OLTP_DB}</database>
    <port>${BI_DB_PORT}</port>
    <username>${BI_DB_USER}</username>
    <password>${BI_DB_PASSWORD}</password>
    <servername/>
