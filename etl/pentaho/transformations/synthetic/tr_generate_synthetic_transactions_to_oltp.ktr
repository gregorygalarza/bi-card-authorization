  </order>
  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>cards_oltp</connection>
    <sql>WITH cfg_base AS (
    SELECT
        d.set_code,
        d.profile_code,
        d.seed,
        d.key_prefix,
        d.target_transactions,
        d.transaction_date_from,
        d.transaction_date_to,
        ss.source_system_id
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'LOADING'
      AND d.olap_status = 'PENDING'
      AND ss.active_flag = TRUE
),

targets AS (
    SELECT
        dt.set_code,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'AUTH_STATUS'
              AND dt.metric_code = 'APPROVED'
        ) AS approved_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'AUTH_STATUS'
              AND dt.metric_code = 'DECLINED'
        ) AS declined_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'AUTH_STATUS'
              AND dt.metric_code = 'REVERSED'
        ) AS reversed_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'AUTH_STATUS'
              AND dt.metric_code = 'ERROR'
        ) AS error_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'GEOGRAPHY'
              AND dt.metric_code = 'DOMESTIC'
        ) AS domestic_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'GEOGRAPHY'
              AND dt.metric_code = 'INTERNATIONAL'
        ) AS international_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'GEOGRAPHY'
              AND dt.metric_code = 'UNKNOWN'
        ) AS unknown_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'KPI'
              AND dt.metric_code = 'INTERNATIONAL_DECLINED'
        ) AS international_declined_target,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'ENTRY_MODE'
              AND dt.metric_code = 'SWIPE'
        ) AS swipe_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'ENTRY_MODE'
              AND dt.metric_code = 'CHIP'
        ) AS chip_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'ENTRY_MODE'
              AND dt.metric_code = 'ONLINE'
        ) AS online_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'DO_NOT_HONOR'
        ) AS dnh_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'INSUFFICIENT_FUNDS'
        ) AS insufficient_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'CREDIT_LIMIT_EXCEEDED'
        ) AS credit_limit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'SECURITY_VIOLATION'
        ) AS security_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'SUSPECTED_FRAUD'
        ) AS suspected_fraud_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'INTERNATIONAL_NOT_ALLOWED'
        ) AS international_not_allowed_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'INVALID_CARD'
        ) AS invalid_card_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'DECLINE_REASON'
              AND dt.metric_code = 'EXPIRED_CARD'
        ) AS expired_card_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'MASTERCARD|DEBIT'
        ) AS mc_debit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'VISA|DEBIT'
        ) AS visa_debit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'VISA|CREDIT'
        ) AS visa_credit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'MASTERCARD|CREDIT'
        ) AS mc_credit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'AMEX|CREDIT'
        ) AS amex_credit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'MASTERCARD|DEBIT_PREPAID'
        ) AS mc_prepaid_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'DISCOVER|CREDIT'
        ) AS discover_credit_total,

        MAX(dt.target_count) FILTER (
            WHERE dt.metric_group = 'CARD_PROFILE'
              AND dt.metric_code = 'VISA|DEBIT_PREPAID'
        ) AS visa_prepaid_total

    FROM ctl.synthetic_dataset_target dt
    WHERE dt.set_code = UPPER(BTRIM('${P_SET_CODE}'))
    GROUP BY dt.set_code
),

cfg AS (
    SELECT
        b.*,
        t.*
    FROM cfg_base b
    JOIN targets t
      ON t.set_code = b.set_code
),

matrix_1 AS (
    SELECT
        cfg.*,

        5259::bigint AS unknown_declined,

        1677::bigint AS domestic_error,
        12::bigint AS international_error,
        224::bigint AS unknown_error,

        49768::bigint AS domestic_reversed,
        604::bigint AS international_reversed,
        709::bigint AS unknown_reversed,

        (
            cfg.declined_total
            - cfg.international_declined_target
            - 5259
        )::bigint AS domestic_declined

    FROM cfg
),

matrix_cfg AS (
    SELECT
        m.*,

        (
            m.domestic_total
            - m.domestic_declined
            - m.domestic_error
            - m.domestic_reversed
        )::bigint AS domestic_approved,

        (
            m.international_total
            - m.international_declined_target
            - m.international_error
            - m.international_reversed
        )::bigint AS international_approved,

        (
            m.unknown_total
            - m.unknown_declined
            - m.unknown_error
            - m.unknown_reversed
        )::bigint AS unknown_approved

    FROM matrix_1 m
),

generated AS (
    SELECT
        cfg.*,

        gs::bigint AS transaction_number,

        cfg.key_prefix
            || ':TX:'
            || LPAD(gs::text, 7, '0')
            AS source_transaction_key,

        (
            MOD(
                ((gs::bigint - 1) * 7919 + cfg.seed)::bigint,
                cfg.target_transactions
            )
            + 1
        )::bigint AS matrix_rank,

        (
            MOD(
                ((gs::bigint - 1) * 104729 + cfg.seed)::bigint,
                cfg.target_transactions
            )
            + 1
        )::bigint AS entry_rank,

        (
            MOD(
                ((gs::bigint - 1) * 65537 + cfg.seed)::bigint,
                cfg.target_transactions
            )
            + 1
        )::bigint AS card_rank,

        (
            MOD(
                ((gs::bigint - 1) * 524287 + cfg.seed)::bigint,
                cfg.target_transactions
            )
            + 1
        )::bigint AS mcc_rank,

        MOD(
            ((gs::bigint - 1) * 32771 + cfg.seed)::bigint,
            10000
        )::integer AS amount_bucket

    FROM matrix_cfg cfg

    CROSS JOIN LATERAL
        generate_series(
            1,
            cfg.target_transactions
        ) AS gs
),

geography AS (
    SELECT
        g.*,

        CASE
            WHEN g.matrix_rank &lt;= g.domestic_total
                THEN 'DOMESTIC'

            WHEN g.matrix_rank
                 &lt;= g.domestic_total + g.international_total
                THEN 'INTERNATIONAL'

            ELSE 'UNKNOWN'
        END AS geography_type,

        CASE
            WHEN g.matrix_rank &lt;= g.domestic_total
                THEN g.matrix_rank

            WHEN g.matrix_rank
                 &lt;= g.domestic_total + g.international_total
                THEN g.matrix_rank - g.domestic_total

            ELSE
                g.matrix_rank
                - g.domestic_total
                - g.international_total
        END::bigint AS geography_rank

    FROM generated g
),

statused AS (
    SELECT
        g.*,

        CASE
            WHEN g.geography_type = 'DOMESTIC' THEN
                CASE
                    WHEN g.geography_rank &lt;= g.domestic_approved
                        THEN 'APPROVED'

                    WHEN g.geography_rank
                         &lt;= g.domestic_approved
                          + g.domestic_declined
                        THEN 'DECLINED'

                    WHEN g.geography_rank
                         &lt;= g.domestic_approved
                          + g.domestic_declined
                          + g.domestic_error
                        THEN 'ERROR'

                    ELSE 'REVERSED'
                END

            WHEN g.geography_type = 'INTERNATIONAL' THEN
                CASE
                    WHEN g.geography_rank &lt;= g.international_approved
                        THEN 'APPROVED'

                    WHEN g.geography_rank
                         &lt;= g.international_approved
                          + g.international_declined_target
                        THEN 'DECLINED'

                    WHEN g.geography_rank
                         &lt;= g.international_approved
                          + g.international_declined_target
                          + g.international_error
                        THEN 'ERROR'

                    ELSE 'REVERSED'
                END

            ELSE
                CASE
                    WHEN g.geography_rank &lt;= g.unknown_approved
                        THEN 'APPROVED'

                    WHEN g.geography_rank
                         &lt;= g.unknown_approved
                          + g.unknown_declined
                        THEN 'DECLINED'

                    WHEN g.geography_rank
                         &lt;= g.unknown_approved
                          + g.unknown_declined
                          + g.unknown_error
                        THEN 'ERROR'

                    ELSE 'REVERSED'
                END
        END AS status_code

    FROM geography g
),

decline_ranked AS (
    SELECT
        s.*,

        CASE
            WHEN s.status_code &lt;&gt; 'DECLINED'
                THEN NULL

            WHEN s.geography_type = 'DOMESTIC'
                THEN s.geography_rank - s.domestic_approved

            WHEN s.geography_type = 'INTERNATIONAL'
                THEN s.geography_rank - s.international_approved

            ELSE
                s.geography_rank - s.unknown_approved
        END::bigint AS decline_rank

    FROM statused s
),

reason_alloc AS (
    SELECT
        d.*,

        (
            d.international_declined_target - 934
        )::bigint AS intl_dnh,

        2290::bigint AS unk_dnh,
        1200::bigint AS unk_insufficient,
        800::bigint AS unk_credit_limit,
        300::bigint AS unk_security,
        450::bigint AS unk_suspected,
        120::bigint AS unk_invalid,
        99::bigint AS unk_expired

    FROM decline_ranked d
),

reason_alloc_2 AS (
    SELECT
        r.*,

        (
            r.dnh_total
            - r.intl_dnh
            - r.unk_dnh
        )::bigint AS dom_dnh,

        (
            r.insufficient_total
            - 47
            - r.unk_insufficient
        )::bigint AS dom_insufficient,

        (
            r.credit_limit_total
            - 39
            - r.unk_credit_limit
        )::bigint AS dom_credit_limit,

        (
            r.security_total
            - 22
            - r.unk_security
        )::bigint AS dom_security,

        (
            r.suspected_fraud_total
            - 152
            - r.unk_suspected
        )::bigint AS dom_suspected,

        (
            r.invalid_card_total
            - r.unk_invalid
        )::bigint AS dom_invalid,

        (
            r.expired_card_total
            - r.unk_expired
        )::bigint AS dom_expired

    FROM reason_alloc r
),

reasoned AS (
    SELECT
        r.*,

        CASE
            WHEN r.status_code &lt;&gt; 'DECLINED'
                THEN NULL

            WHEN r.geography_type = 'DOMESTIC' THEN
                CASE
                    WHEN r.decline_rank &lt;= r.dom_dnh
                        THEN 'DO_NOT_HONOR'

                    WHEN r.decline_rank
                         &lt;= r.dom_dnh
                          + r.dom_insufficient
                        THEN 'INSUFFICIENT_FUNDS'

                    WHEN r.decline_rank
                         &lt;= r.dom_dnh
                          + r.dom_insufficient
                          + r.dom_credit_limit
                        THEN 'CREDIT_LIMIT_EXCEEDED'

                    WHEN r.decline_rank
                         &lt;= r.dom_dnh
                          + r.dom_insufficient
                          + r.dom_credit_limit
                          + r.dom_security
                        THEN 'SECURITY_VIOLATION'

                    WHEN r.decline_rank
                         &lt;= r.dom_dnh
                          + r.dom_insufficient
                          + r.dom_credit_limit
                          + r.dom_security
                          + r.dom_suspected
                        THEN 'SUSPECTED_FRAUD'

                    WHEN r.decline_rank
                         &lt;= r.dom_dnh
                          + r.dom_insufficient
                          + r.dom_credit_limit
                          + r.dom_security
                          + r.dom_suspected
                          + r.dom_invalid
                        THEN 'INVALID_CARD'

                    ELSE 'EXPIRED_CARD'
                END

            WHEN r.geography_type = 'INTERNATIONAL' THEN
                CASE
                    WHEN r.decline_rank &lt;= r.intl_dnh
                        THEN 'DO_NOT_HONOR'

                    WHEN r.decline_rank
                         &lt;= r.intl_dnh + 47
                        THEN 'INSUFFICIENT_FUNDS'

                    WHEN r.decline_rank
                         &lt;= r.intl_dnh + 47 + 39
                        THEN 'CREDIT_LIMIT_EXCEEDED'

                    WHEN r.decline_rank
                         &lt;= r.intl_dnh + 47 + 39 + 22
                        THEN 'SECURITY_VIOLATION'

                    WHEN r.decline_rank
                         &lt;= r.intl_dnh + 47 + 39 + 22 + 152
                        THEN 'SUSPECTED_FRAUD'

                    ELSE 'INTERNATIONAL_NOT_ALLOWED'
                END

            ELSE
                CASE
                    WHEN r.decline_rank &lt;= r.unk_dnh
                        THEN 'DO_NOT_HONOR'

                    WHEN r.decline_rank
                         &lt;= r.unk_dnh
                          + r.unk_insufficient
                        THEN 'INSUFFICIENT_FUNDS'

                    WHEN r.decline_rank
                         &lt;= r.unk_dnh
                          + r.unk_insufficient
                          + r.unk_credit_limit
                        THEN 'CREDIT_LIMIT_EXCEEDED'

                    WHEN r.decline_rank
                         &lt;= r.unk_dnh
                          + r.unk_insufficient
                          + r.unk_credit_limit
                          + r.unk_security
                        THEN 'SECURITY_VIOLATION'

                    WHEN r.decline_rank
                         &lt;= r.unk_dnh
                          + r.unk_insufficient
                          + r.unk_credit_limit
                          + r.unk_security
                          + r.unk_suspected
                        THEN 'SUSPECTED_FRAUD'

                    WHEN r.decline_rank
                         &lt;= r.unk_dnh
                          + r.unk_insufficient
                          + r.unk_credit_limit
                          + r.unk_security
                          + r.unk_suspected
                          + r.unk_invalid
                        THEN 'INVALID_CARD'

                    ELSE 'EXPIRED_CARD'
                END
        END AS decline_reason_code

    FROM reason_alloc_2 r
),

assigned AS (
    SELECT
        r.*,

        CASE
            WHEN r.entry_rank &lt;= r.swipe_total
                THEN 'Swipe Transaction'

            WHEN r.entry_rank
                 &lt;= r.swipe_total + r.chip_total
                THEN 'Chip Transaction'

            ELSE 'Online Transaction'
        END::varchar(50) AS entry_mode,

        CASE
            WHEN r.card_rank &lt;= r.mc_debit_total
                THEN 'Mastercard'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total + r.visa_debit_total
                THEN 'Visa'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                THEN 'Visa'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                THEN 'Mastercard'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                THEN 'Amex'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                  + r.mc_prepaid_total
                THEN 'Mastercard'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                  + r.mc_prepaid_total
                  + r.discover_credit_total
                THEN 'Discover'

            ELSE 'Visa'
        END::varchar(30) AS desired_card_brand,

        CASE
            WHEN r.card_rank &lt;= r.mc_debit_total
                THEN 'Debit'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total + r.visa_debit_total
                THEN 'Debit'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                THEN 'Credit'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                THEN 'Credit'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                THEN 'Credit'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                  + r.mc_prepaid_total
                THEN 'Debit (Prepaid)'

            WHEN r.card_rank
                 &lt;= r.mc_debit_total
                  + r.visa_debit_total
                  + r.visa_credit_total
                  + r.mc_credit_total
                  + r.amex_credit_total
                  + r.mc_prepaid_total
                  + r.discover_credit_total
                THEN 'Credit'

            ELSE 'Debit (Prepaid)'
        END::varchar(30) AS desired_card_type,

        CASE
            WHEN r.mcc_rank &lt;= 117403 THEN '5411'
            WHEN r.mcc_rank &lt;= 227414 THEN '5499'
            WHEN r.mcc_rank &lt;= 335717 THEN '5541'
            WHEN r.mcc_rank &lt;= 409503 THEN '5812'
            WHEN r.mcc_rank &lt;= 467272 THEN '5912'
            WHEN r.mcc_rank &lt;= 513412 THEN '4784'
            WHEN r.mcc_rank &lt;= 559501 THEN '5300'
            WHEN r.mcc_rank &lt;= 605009 THEN '4829'
            WHEN r.mcc_rank &lt;= 645290 THEN '4121'
            WHEN r.mcc_rank &lt;= 682826 THEN '7538'
            WHEN r.mcc_rank &lt;= 719772 THEN '5814'
            WHEN r.mcc_rank &lt;= 756121 THEN '5311'
            WHEN r.mcc_rank &lt;= 774901 THEN '4900'
            WHEN r.mcc_rank &lt;= 793537 THEN '5310'
            WHEN r.mcc_rank &lt;= 811554 THEN '5813'
            WHEN r.mcc_rank &lt;= 828663 THEN '5942'
            WHEN r.mcc_rank &lt;= 845385 THEN '4814'
            WHEN r.mcc_rank &lt;= 858660 THEN '5211'
            WHEN r.mcc_rank &lt;= 868877 THEN '7832'
            WHEN r.mcc_rank &lt;= 878138 THEN '5921'
            WHEN r.mcc_rank &lt;= 886291 THEN '7230'
            WHEN r.mcc_rank &lt;= 893507 THEN '9402'
            WHEN r.mcc_rank &lt;= 900715 THEN '4214'
            WHEN r.mcc_rank &lt;= 907848 THEN '4111'
            WHEN r.mcc_rank &lt;= 914426 THEN '5719'
            ELSE 'OTHER'
        END::varchar(30) AS desired_mcc_code,

        CASE
            WHEN r.geography_type = 'DOMESTIC'
                THEN 'US'

            WHEN r.geography_type = 'UNKNOWN'
                THEN 'ZZ'

            WHEN r.geography_rank &lt;= 1935 THEN 'MX'
            WHEN r.geography_rank &lt;= 2762 THEN 'CA'
            WHEN r.geography_rank &lt;= 3120 THEN 'IT'
            WHEN r.geography_rank &lt;= 3451 THEN 'GB'
            WHEN r.geography_rank &lt;= 3669 THEN 'FR'
            WHEN r.geography_rank &lt;= 3885 THEN 'DE'
            WHEN r.geography_rank &lt;= 4090 THEN 'CN'
            WHEN r.geography_rank &lt;= 4252 THEN 'JP'
            WHEN r.geography_rank &lt;= 4395 THEN 'IN'
            WHEN r.geography_rank &lt;= 4526 THEN 'ES'
            WHEN r.geography_rank &lt;= 4639 THEN 'DO'
            WHEN r.geography_rank &lt;= 4746 THEN 'NL'
            WHEN r.geography_rank &lt;= 4836 THEN 'JM'
            WHEN r.geography_rank &lt;= 4925 THEN 'KR'
            WHEN r.geography_rank &lt;= 5005 THEN 'CH'
            WHEN r.geography_rank &lt;= 5077 THEN 'IL'
            WHEN r.geography_rank &lt;= 5147 THEN 'IE'
            WHEN r.geography_rank &lt;= 5216 THEN 'BS'
            WHEN r.geography_rank &lt;= 5279 THEN 'TW'
            WHEN r.geography_rank &lt;= 5338 THEN 'CO'
            WHEN r.geography_rank &lt;= 5397 THEN 'AT'
            WHEN r.geography_rank &lt;= 5449 THEN 'CR'
            WHEN r.geography_rank &lt;= 5500 THEN 'TH'
            WHEN r.geography_rank &lt;= 5549 THEN 'PH'
            WHEN r.geography_rank &lt;= 5596 THEN 'BR'
            ELSE 'OTHER'
        END::varchar(10) AS desired_country_code,

        CASE
            WHEN r.decline_reason_code = 'SUSPECTED_FRAUD'
                THEN TRUE

            WHEN r.status_code = 'APPROVED'
             AND r.geography_type = 'DOMESTIC'
             AND r.geography_rank &lt;= 123
                THEN TRUE

            WHEN r.status_code = 'APPROVED'
             AND r.geography_type = 'INTERNATIONAL'
             AND r.geography_rank &lt;= 115
                THEN TRUE

            WHEN r.status_code = 'APPROVED'
             AND r.geography_type = 'UNKNOWN'
             AND r.geography_rank &lt;= 303
                THEN TRUE

            ELSE FALSE
        END AS fraud_flag,

        CASE
            WHEN r.status_code = 'ERROR'
                THEN TRUE

            WHEN COALESCE(r.decline_reason_code, '') IN (
                'INSUFFICIENT_FUNDS',
                'SECURITY_VIOLATION',
                'INVALID_CARD',
                'EXPIRED_CARD'
            )
                THEN TRUE

            WHEN r.geography_type = 'DOMESTIC'
             AND r.decline_reason_code = 'DO_NOT_HONOR'
             AND r.decline_rank &lt;= 718
                THEN TRUE

            ELSE FALSE
        END AS error_flag

    FROM reasoned r
),

card_pool AS (
    SELECT
        c.card_id,
        c.card_brand,
        c.card_type,
        c.credit_limit,

        ROW_NUMBER() OVER (
            PARTITION BY c.card_brand, c.card_type
            ORDER BY c.source_card_key
        )::bigint AS profile_card_number,

        COUNT(*) OVER (
            PARTITION BY c.card_brand, c.card_type
        )::bigint AS profile_card_count

    FROM cfg

    JOIN oltp.card c
      ON c.source_system_id = cfg.source_system_id
     AND c.source_card_key
         LIKE cfg.key_prefix || ':CARD:%'
),

card_profile_counts AS (
    SELECT DISTINCT
        card_brand,
        card_type,
        profile_card_count
    FROM card_pool
),

expired_cards AS (
    SELECT
        c.card_id,
        c.credit_limit,

        ROW_NUMBER() OVER (
            ORDER BY c.source_card_key
        )::bigint AS expired_number,

        COUNT(*) OVER ()::bigint AS expired_count

    FROM cfg

    JOIN oltp.card c
      ON c.source_system_id = cfg.source_system_id
     AND c.source_card_key
         LIKE cfg.key_prefix || ':CARD:%'

    WHERE c.expiration_year &lt; 2019
),

low_limit_cards AS (
    SELECT
        c.card_id,
        c.credit_limit,

        ROW_NUMBER() OVER (
            ORDER BY c.source_card_key
        )::bigint AS low_limit_number,

        COUNT(*) OVER ()::bigint AS low_limit_count

    FROM cfg

    JOIN oltp.card c
      ON c.source_system_id = cfg.source_system_id
     AND c.source_card_key
         LIKE cfg.key_prefix || ':CARD:%'

    WHERE c.credit_limit &lt; 125
),

normal_card_selected AS (
    SELECT
        a.*,
        cp.card_id AS normal_card_id,
        cp.credit_limit AS normal_credit_limit

    FROM assigned a

    JOIN card_profile_counts pc
      ON pc.card_brand = a.desired_card_brand
     AND pc.card_type = a.desired_card_type

    JOIN card_pool cp
      ON cp.card_brand = a.desired_card_brand
     AND cp.card_type = a.desired_card_type
     AND cp.profile_card_number =
         1
         + MOD(
             (
                 a.transaction_number * 3571
                 + a.seed
             )::bigint,
             pc.profile_card_count
         )
),

cards_selected AS (
    SELECT
        n.*,

        CASE
            WHEN n.decline_reason_code = 'EXPIRED_CARD'
                THEN ec.card_id

            WHEN n.decline_reason_code = 'CREDIT_LIMIT_EXCEEDED'
                THEN lc.card_id

            ELSE n.normal_card_id
        END AS card_id,

        CASE
            WHEN n.decline_reason_code = 'EXPIRED_CARD'
                THEN ec.credit_limit

            WHEN n.decline_reason_code = 'CREDIT_LIMIT_EXCEEDED'
                THEN lc.credit_limit

            ELSE n.normal_credit_limit
        END AS selected_credit_limit

    FROM normal_card_selected n

    LEFT JOIN expired_cards ec
      ON n.decline_reason_code = 'EXPIRED_CARD'
     AND ec.expired_number =
         1
         + MOD(
             (
                 n.transaction_number * 2017
                 + n.seed
             )::bigint,
             ec.expired_count
         )

    LEFT JOIN low_limit_cards lc
      ON n.decline_reason_code = 'CREDIT_LIMIT_EXCEEDED'
     AND lc.low_limit_number =
         1
         + MOD(
             (
                 n.transaction_number * 3011
                 + n.seed
             )::bigint,
             lc.low_limit_count
         )
),

location_pool AS (
    SELECT
        ml.location_id,
        BTRIM(ml.country_code)::varchar(2) AS country_code,

        ROW_NUMBER() OVER (
            PARTITION BY BTRIM(ml.country_code)
            ORDER BY ml.source_location_key
        )::bigint AS location_number,

        COUNT(*) OVER (
            PARTITION BY BTRIM(ml.country_code)
        )::bigint AS location_count

    FROM cfg

    JOIN oltp.merchant m
      ON m.source_system_id = cfg.source_system_id
     AND m.source_merchant_key
         LIKE cfg.key_prefix || ':MERCHANT:%'

    JOIN oltp.merchant_location ml
      ON ml.merchant_id = m.merchant_id
     AND ml.source_location_key
         LIKE cfg.key_prefix || ':LOCATION:%'
),

location_counts AS (
    SELECT DISTINCT
        country_code,
        location_count
    FROM location_pool
),

other_countries AS (
    SELECT
        q.country_code,

        ROW_NUMBER() OVER (
            ORDER BY q.country_code
        )::bigint AS country_number,

        COUNT(*) OVER ()::bigint AS country_count

    FROM (
        SELECT DISTINCT country_code
        FROM location_pool
        WHERE country_code NOT IN (
            'US','ZZ',
            'MX','CA','IT','GB','FR','DE','CN','JP','IN','ES',
            'DO','NL','JM','KR','CH','IL','IE','BS','TW','CO',
            'AT','CR','TH','PH','BR'
        )
    ) q
),

country_resolved AS (
    SELECT
        c.*,

        CASE
            WHEN c.desired_country_code = 'OTHER'
                THEN oc.country_code
            ELSE c.desired_country_code
        END::varchar(2) AS final_country_code

    FROM cards_selected c

    LEFT JOIN other_countries oc
      ON c.desired_country_code = 'OTHER'
     AND oc.country_number =
         1
         + MOD(
             (
                 c.transaction_number * 1877
                 + c.seed
             )::bigint,
             oc.country_count
         )
),

location_selected AS (
    SELECT
        c.*,
        lp.location_id AS merchant_location_id

    FROM country_resolved c

    JOIN location_counts lcnt
      ON lcnt.country_code = c.final_country_code

    JOIN location_pool lp
      ON lp.country_code = c.final_country_code
     AND lp.location_number =
         1
         + MOD(
             (
                 c.transaction_number * 4001
                 + c.seed
             )::bigint,
             lcnt.location_count
         )
),

other_mcc AS (
    SELECT
        mc.category_id,

        ROW_NUMBER() OVER (
            ORDER BY mc.category_code
        )::bigint AS mcc_number,

        COUNT(*) OVER ()::bigint AS mcc_count

    FROM oltp.merchant_category mc
    WHERE mc.active_flag = TRUE
      AND mc.category_scheme = 'MCC'
      AND mc.category_code NOT IN (
          '5411','5499','5541','5812','5912',
          '4784','5300','4829','4121','7538',
          '5814','5311','4900','5310','5813',
          '5942','4814','5211','7832','5921',
          '7230','9402','4214','4111','5719'
      )
),

mcc_selected AS (
    SELECT
        l.*,

        CASE
            WHEN l.desired_mcc_code = 'OTHER'
                THEN om.category_id
            ELSE mc.category_id
        END AS category_id

    FROM location_selected l

    LEFT JOIN oltp.merchant_category mc
      ON l.desired_mcc_code &lt;&gt; 'OTHER'
     AND mc.category_scheme = 'MCC'
     AND mc.category_code = l.desired_mcc_code

    LEFT JOIN other_mcc om
      ON l.desired_mcc_code = 'OTHER'
     AND om.mcc_number =
         1
         + MOD(
             (
                 l.transaction_number * 5003
                 + l.seed
             )::bigint,
             om.mcc_count
         )
),

amount_base AS (
    SELECT
        m.*,
        ap.avg_abs_amount,
        ap.p25,
        ap.p50,
        ap.p75,
        ap.p90,
        ap.p95,
        ap.p99,

        ROUND(
            CASE
                WHEN m.amount_bucket &lt; 2500 THEN
                    1
                    + (ap.p25 - 1)
                    * m.amount_bucket
                    / 2499.0

                WHEN m.amount_bucket &lt; 5000 THEN
                    ap.p25
                    + (ap.p50 - ap.p25)
                    * (m.amount_bucket - 2500)
                    / 2499.0

                WHEN m.amount_bucket &lt; 7500 THEN
                    ap.p50
                    + (ap.p75 - ap.p50)
                    * (m.amount_bucket - 5000)
                    / 2499.0

                WHEN m.amount_bucket &lt; 9000 THEN
                    ap.p75
                    + (ap.p90 - ap.p75)
                    * (m.amount_bucket - 7500)
                    / 1499.0

                WHEN m.amount_bucket &lt; 9500 THEN
                    ap.p90
                    + (ap.p95 - ap.p90)
                    * (m.amount_bucket - 9000)
                    / 499.0

                WHEN m.amount_bucket &lt; 9900 THEN
                    ap.p95
                    + (ap.p99 - ap.p95)
                    * (m.amount_bucket - 9500)
                    / 399.0

                ELSE
                    ap.p99
                    + ap.p99
                    * (m.amount_bucket - 9900)
                    / 99.0
            END::numeric,
            2
        ) AS generated_abs_amount

    FROM mcc_selected m

    JOIN ctl.synthetic_amount_profile ap
      ON ap.profile_code = m.profile_code
     AND ap.status_code = m.status_code
),

decline_catalog AS (
    SELECT
        reason_code,
        MIN(decline_reason_id) AS decline_reason_id
    FROM oltp.decline_reason
    GROUP BY reason_code
)

SELECT
    a.source_system_id,

    a.source_transaction_key,

    a.card_id,

    a.merchant_location_id,

    a.category_id,

    aus.authorization_status_id,

    dr.decline_reason_id,

    (
        (
            a.transaction_date_from
            + MOD(
                (
                    (a.transaction_number - 1) * 8191
                    + a.seed
                )::bigint,
                (
                    a.transaction_date_to
                    - a.transaction_date_from
                    + 1
                )
            )::integer
        )::timestamp

        + make_interval(
            secs =>
                MOD(
                    (
                        (a.transaction_number - 1) * 131071
                        + a.seed * 17
                    )::bigint,
                    86400
                )::integer
        )
    ) AT TIME ZONE 'UTC'
        AS transaction_datetime,

    (
        CASE
            WHEN a.status_code = 'REVERSED'
                THEN -a.generated_abs_amount

            WHEN a.decline_reason_code = 'CREDIT_LIMIT_EXCEEDED'
                THEN
                    GREATEST(
                        a.generated_abs_amount,
                        a.selected_credit_limit
                        + 25
                        + MOD(
                            (
                                a.transaction_number * 43
                                + a.seed
                            )::bigint,
                            100
                        )
                    )

            ELSE a.generated_abs_amount
        END
    )::numeric(18,2)
        AS amount,

    a.entry_mode,

    CASE
        WHEN a.status_code = 'APPROVED'
            THEN 'APPROVED'

        WHEN a.status_code = 'REVERSED'
            THEN 'REVERSED'

        WHEN a.status_code = 'ERROR'
            THEN 'TECHNICAL_ERROR'

        ELSE a.decline_reason_code
    END::varchar(30)
        AS authorization_response_code,

    COALESCE(a.error_flag, FALSE)
        AS error_flag,

    COALESCE(a.fraud_flag, FALSE)
        AS fraud_flag

FROM amount_base a

JOIN oltp.authorization_status aus
  ON aus.status_code = a.status_code

LEFT JOIN decline_catalog dr
  ON dr.reason_code = a.decline_reason_code;</sql>
