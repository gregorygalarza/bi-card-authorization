    <connection>cards_oltp</connection>
    <sql>WITH cfg AS (
    SELECT
        d.set_code,
        d.key_prefix,
        ss.source_system_id
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'LOADING'
      AND d.olap_status = 'PENDING'
      AND ss.active_flag = TRUE
),

flagged AS (
    SELECT
        t.transaction_id,
        t.source_transaction_key,
        aus.status_code,
        dr.reason_code
    FROM cfg
    JOIN oltp.card_transaction t
      ON t.source_system_id = cfg.source_system_id
     AND t.source_transaction_key
         LIKE cfg.key_prefix || ':TX:%'
    JOIN oltp.authorization_status aus
      ON aus.authorization_status_id =
         t.authorization_status_id
    LEFT JOIN oltp.decline_reason dr
      ON dr.decline_reason_id =
         t.decline_reason_id
    WHERE t.error_flag IS TRUE
),

security_ranked AS (
    SELECT
        transaction_id,
        source_transaction_key,

        ROW_NUMBER() OVER (
            ORDER BY source_transaction_key
        )::bigint AS security_rank

    FROM flagged
    WHERE reason_code = 'SECURITY_VIOLATION'
),

dnh_ranked AS (
    SELECT
        transaction_id,
        source_transaction_key,

        ROW_NUMBER() OVER (
            ORDER BY source_transaction_key
        )::bigint AS dnh_rank

    FROM flagged
    WHERE reason_code = 'DO_NOT_HONOR'
),

primary_errors AS (
    SELECT
        f.transaction_id,

        CASE
            -- ---------------------------------------------
            -- ERROR status
            -- 1,913 primary occurrences
            -- ---------------------------------------------
            WHEN f.status_code = 'ERROR'
                THEN 'TECHNICAL_ERROR'

            -- ---------------------------------------------
            -- Direct business mappings
            -- ---------------------------------------------
            WHEN f.reason_code = 'INSUFFICIENT_FUNDS'
                THEN 'INSUFFICIENT_FUNDS'

            WHEN f.reason_code = 'INVALID_CARD'
                THEN 'INVALID_CARD'

            WHEN f.reason_code = 'EXPIRED_CARD'
                THEN 'EXPIRED_CARD'

            -- ---------------------------------------------
            -- SECURITY_VIOLATION
            -- Total = 2,819
            --
            -- BAD_PIN      2,443
            -- BAD_CVV        290
            -- BAD_ZIPCODE     86
            -- ---------------------------------------------
            WHEN f.reason_code = 'SECURITY_VIOLATION'
             AND sr.security_rank &lt;= 2443
                THEN 'BAD_PIN'

            WHEN f.reason_code = 'SECURITY_VIOLATION'
             AND sr.security_rank &lt;= 2733
                THEN 'BAD_CVV'

            WHEN f.reason_code = 'SECURITY_VIOLATION'
                THEN 'BAD_ZIPCODE'

            -- ---------------------------------------------
            -- Flagged DO_NOT_HONOR
            -- Total = 718
            --
            -- INSUFFICIENT_FUNDS  525
            -- TECHNICAL_ERROR      90
            -- INVALID_CARD          8
            -- EXPIRED_CARD          5
            -- BAD_CVV              90
            -- ---------------------------------------------
            WHEN f.reason_code = 'DO_NOT_HONOR'
             AND dr.dnh_rank &lt;= 525
                THEN 'INSUFFICIENT_FUNDS'

            WHEN f.reason_code = 'DO_NOT_HONOR'
             AND dr.dnh_rank &lt;= 615
                THEN 'TECHNICAL_ERROR'

            WHEN f.reason_code = 'DO_NOT_HONOR'
             AND dr.dnh_rank &lt;= 623
                THEN 'INVALID_CARD'

            WHEN f.reason_code = 'DO_NOT_HONOR'
             AND dr.dnh_rank &lt;= 628
                THEN 'EXPIRED_CARD'

            WHEN f.reason_code = 'DO_NOT_HONOR'
                THEN 'BAD_CVV'

            ELSE NULL
        END::varchar(80) AS error_code,

        'PRIMARY'::varchar(20) AS occurrence_type

    FROM flagged f

    LEFT JOIN security_ranked sr
      ON sr.transaction_id = f.transaction_id

    LEFT JOIN dnh_ranked dr
      ON dr.transaction_id = f.transaction_id
),

extra_errors AS (
    -- -----------------------------------------------------
    -- 70 additional occurrences
    --
    -- Se agregan como BAD_CVV a 70 transacciones de
    -- SECURITY_VIOLATION cuyo primary error es BAD_PIN.
    --
    -- Como su primary error es BAD_PIN, no colisionan con
    -- PK(transaction_id,error_id).
    -- -----------------------------------------------------

    SELECT
        sr.transaction_id,
        'BAD_CVV'::varchar(80) AS error_code,
        'SECONDARY'::varchar(20) AS occurrence_type

    FROM security_ranked sr

    WHERE sr.security_rank &lt;= 70
),

all_errors AS (
    SELECT
        transaction_id,
        error_code,
        occurrence_type
    FROM primary_errors

    UNION ALL

    SELECT
        transaction_id,
        error_code,
        occurrence_type
    FROM extra_errors
)

SELECT
    ae.transaction_id,

    ec.error_id,

    (
        'Synthetic '
        || LOWER(ae.occurrence_type)
        || ' error - '
        || ae.error_code
        || ' - '
        || cfg.set_code
    )::varchar(500) AS error_detail

FROM all_errors ae

CROSS JOIN cfg

JOIN oltp.error_catalog ec
  ON ec.error_code = ae.error_code

WHERE ae.error_code IS NOT NULL;</sql>
