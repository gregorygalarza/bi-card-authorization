    <connection>cards_oltp</connection>
    <sql>WITH cfg AS (
    SELECT
        d.set_code,
        d.seed,
        d.key_prefix,
        d.target_customers,
        d.target_cards,
        ss.source_system_id
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'LOADING'
      AND ss.active_flag = TRUE
),
customers AS (
    SELECT
        c.customer_id,
        c.source_customer_key,
        ROW_NUMBER() OVER (
            ORDER BY c.source_customer_key
        )::integer AS customer_number
    FROM cfg
    JOIN oltp.customer c
      ON c.source_system_id = cfg.source_system_id
     AND c.source_customer_key
         LIKE cfg.key_prefix || ':CUSTOMER:%'
),
generated AS (
    SELECT
        cfg.*,
        gs::integer AS card_number,

        1
        + MOD(
            gs::integer - 1,
            cfg.target_customers
        ) AS customer_number,

        cfg.key_prefix
            || ':CARD:'
            || LPAD(gs::text, 6, '0')
            AS source_card_key

    FROM cfg
    CROSS JOIN LATERAL
        generate_series(1, cfg.target_cards) AS gs
),
classified AS (
    SELECT
        g.*,

        CASE
            WHEN card_number &lt;= 120
                THEN 'Mastercard'
            WHEN card_number &lt;= 185
                THEN 'Visa'
            WHEN card_number &lt;= 223
                THEN 'Visa'
            WHEN card_number &lt;= 250
                THEN 'Mastercard'
            WHEN card_number &lt;= 270
                THEN 'Amex'
            WHEN card_number &lt;= 284
                THEN 'Mastercard'
            WHEN card_number &lt;= 293
                THEN 'Discover'
            ELSE 'Visa'
        END AS card_brand,

        CASE
            WHEN card_number &lt;= 120
                THEN 'Debit'
            WHEN card_number &lt;= 185
                THEN 'Debit'
            WHEN card_number &lt;= 223
                THEN 'Credit'
            WHEN card_number &lt;= 250
                THEN 'Credit'
            WHEN card_number &lt;= 270
                THEN 'Credit'
            WHEN card_number &lt;= 284
                THEN 'Debit (Prepaid)'
            WHEN card_number &lt;= 293
                THEN 'Credit'
            ELSE 'Debit (Prepaid)'
        END AS card_type

    FROM generated g
)
SELECT
    c.customer_id,

    cl.source_system_id,

    'US'::char(2)
        AS issuer_country_code,

    cl.source_card_key,

    ctl.fn_sha256_hex(
        cl.source_card_key || '|PAN_TOKEN|v1'
    )::varchar(128)
        AS card_number_token,

    cl.card_brand::varchar(30)
        AS card_brand,

    cl.card_type::varchar(30)
        AS card_type,

    (
        1
        + MOD(
            ctl.fn_bucket_100(
                cl.source_card_key || '|EXP_MONTH|v1'
            ),
            12
        )
    )::smallint
        AS expiration_month,

    (
        CASE
            WHEN MOD(cl.card_number, 25) = 0
                THEN 2018

            ELSE
                2027
                + MOD(
                    ctl.fn_bucket_100(
                        cl.source_card_key || '|EXP_YEAR|v2'
                    ),
                    5
                )
        END
    )::smallint
        AS expiration_year,

    CASE
        WHEN cl.card_type IN (
            'Credit',
            'Debit'
        )
            THEN TRUE

        ELSE
            ctl.fn_bucket_100(
                cl.source_card_key || '|CHIP|v1'
            ) &lt; 75
    END
        AS has_chip,

    1::smallint
        AS cards_issued,

    (
        CASE
            WHEN MOD(cl.card_number, 10) = 0
                THEN
                    25
                    + ctl.fn_bucket_100(
                        cl.source_card_key || '|LIMIT_LOW|v2'
                    )

            WHEN cl.card_type = 'Credit'
                THEN
                    500
                    + ctl.fn_bucket_100(
                        cl.source_card_key || '|LIMIT|v2'
                    ) * 75

            WHEN cl.card_type = 'Debit (Prepaid)'
                THEN
                    250
                    + ctl.fn_bucket_100(
                        cl.source_card_key || '|LIMIT|v2'
                    ) * 10

            ELSE
                1000
                + ctl.fn_bucket_100(
                    cl.source_card_key || '|LIMIT|v2'
                ) * 25
        END
    )::numeric(18,2)
        AS credit_limit,

    (
        DATE '2010-01-01'
        + (
            MOD(
                ctl.fn_bucket_100(
                    cl.source_card_key || '|OPEN_DATE|v1'
                ) * 37,
                3000
            )
        )::integer
    )::date
        AS account_open_date,

    (
        2015
        + MOD(
            ctl.fn_bucket_100(
                cl.source_card_key || '|PIN_YEAR|v1'
            ),
            5
        )
    )::smallint
        AS pin_last_changed_year,

    (
        ctl.fn_bucket_100(
            cl.source_card_key || '|DARK_WEB|v1'
        ) &lt; 2
    )
        AS dark_web_flag

FROM classified cl
JOIN customers c
  ON c.customer_number = cl.customer_number

ORDER BY cl.card_number;</sql>
