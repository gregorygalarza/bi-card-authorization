      <schema_name/>
    </partitioning>
    <connection>cards_oltp</connection>
    <sql>WITH primary_error AS (
    SELECT DISTINCT ON (te.transaction_id)
        te.transaction_id,
        ec.error_code
    FROM oltp.transaction_error te
    JOIN oltp.error_catalog ec
      ON ec.error_id = te.error_id
    ORDER BY
        te.transaction_id,
        CASE ec.error_code
            WHEN 'TECHNICAL_ERROR'    THEN 10
            WHEN 'INSUFFICIENT_FUNDS' THEN 20
            WHEN 'EXPIRED_CARD'       THEN 30
            WHEN 'INVALID_CARD'       THEN 40
            WHEN 'BAD_PIN'            THEN 50
            WHEN 'BAD_CVV'            THEN 60
            WHEN 'BAD_ZIPCODE'        THEN 70
            ELSE 999
        END,
        ec.error_code
)
SELECT
    t.transaction_id AS oltp_transaction_id,

    'IBM_CORE'::varchar(30) AS source_system_code,

    t.source_transaction_key,

    dd.date_key,

    dcu.customer_key,

    dc.card_key,

    dm.merchant_key,

    dml.merchant_location_key,

    dmc.merchant_category_key,

    das.authorization_status_key,

    COALESCE(
        ddr.decline_reason_key,
        ddr_na.decline_reason_key
    ) AS decline_reason_key,

    dem.entry_mode_key,

    COALESCE(
        de.error_key,
        de_na.error_key
    ) AS primary_error_key,

    t.transaction_datetime,

    EXTRACT(
        HOUR FROM t.transaction_datetime AT TIME ZONE 'UTC'
    )::smallint AS transaction_hour,

    t.amount,

    1::smallint AS transaction_count,

    CASE
        WHEN c.issuer_country_code = 'ZZ'
          OR ml.country_code = 'ZZ'
            THEN NULL
        WHEN c.issuer_country_code &lt;&gt; ml.country_code
            THEN TRUE
        ELSE FALSE
    END AS international_flag,

    (aus.status_code = 'DECLINED') AS declined_flag,

    (aus.status_code = 'APPROVED') AS approved_flag,

    (aus.status_code = 'REVERSED') AS reversed_flag,

    COALESCE(t.error_flag, FALSE) AS error_flag,

    COALESCE(t.fraud_flag, FALSE) AS fraud_flag

FROM oltp.card_transaction t

JOIN oltp.card c
  ON c.card_id = t.card_id

JOIN oltp.customer cu
  ON cu.customer_id = c.customer_id

JOIN oltp.merchant_location ml
  ON ml.location_id = t.merchant_location_id

JOIN oltp.merchant m
  ON m.merchant_id = ml.merchant_id

JOIN oltp.authorization_status aus
  ON aus.authorization_status_id = t.authorization_status_id

LEFT JOIN oltp.decline_reason dr
  ON dr.decline_reason_id = t.decline_reason_id

LEFT JOIN oltp.merchant_category mc
  ON mc.category_id = t.category_id

JOIN olap.dim_date dd
  ON dd.full_date =
     (t.transaction_datetime AT TIME ZONE 'UTC')::date

JOIN olap.dim_customer dcu
  ON dcu.source_system_code = 'IBM_CORE'
 AND dcu.source_customer_key = cu.source_customer_key

JOIN olap.dim_card dc
  ON dc.source_system_code = 'IBM_CORE'
 AND dc.source_card_key = c.source_card_key

JOIN olap.dim_merchant dm
  ON dm.source_system_code = 'IBM_CORE'
 AND dm.source_merchant_key = m.source_merchant_key

JOIN olap.dim_merchant_location dml
  ON dml.source_system_code = 'IBM_CORE'
 AND dml.source_location_key = ml.source_location_key

JOIN olap.dim_merchant_category dmc
  ON dmc.category_scheme = mc.category_scheme
 AND dmc.mcc_code = mc.category_code

JOIN olap.dim_authorization_status das
  ON das.status_code = aus.status_code

LEFT JOIN olap.dim_decline_reason ddr
  ON ddr.reason_code = dr.reason_code

JOIN olap.dim_decline_reason ddr_na
  ON ddr_na.reason_code = 'NOT_APPLICABLE'

JOIN olap.dim_entry_mode dem
  ON dem.entry_mode_code =
     CASE
         WHEN UPPER(BTRIM(COALESCE(t.entry_mode, '')))
              IN ('SWIPE', 'SWIPE TRANSACTION')
             THEN 'SWIPE'

         WHEN UPPER(BTRIM(COALESCE(t.entry_mode, '')))
              IN ('CHIP', 'CHIP TRANSACTION')
             THEN 'CHIP'

         WHEN UPPER(BTRIM(COALESCE(t.entry_mode, '')))
              IN ('ONLINE', 'ONLINE TRANSACTION')
             THEN 'ONLINE'

         ELSE 'UNKNOWN'
     END

LEFT JOIN primary_error pe
  ON pe.transaction_id = t.transaction_id

LEFT JOIN olap.dim_error de
  ON de.error_code = pe.error_code

JOIN olap.dim_error de_na
  ON de_na.error_code = 'NOT_APPLICABLE';</sql>
