    <connection>cards_oltp</connection>
    <sql>WITH cfg AS (
    SELECT
        d.set_code,
        d.source_system_code,
        d.key_prefix,
        d.transaction_date_to
    FROM ctl.synthetic_dataset d
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'VALIDATED'
      AND d.olap_status = 'LOADING'
),

source_system AS (
    SELECT
        cfg.*,
        ss.source_system_id
    FROM cfg
    JOIN oltp.source_system ss
      ON ss.source_code = cfg.source_system_code
     AND ss.active_flag = TRUE
),

customer_base AS (
    SELECT
        c.customer_id,
        ss.source_system_code,
        c.source_customer_key,
        c.full_name,
        c.first_name,
        c.last_name,
        c.gender,
        c.retirement_age,
        c.birth_year,
        c.birth_month,
        ss.transaction_date_to
    FROM source_system ss
    JOIN oltp.customer c
      ON c.source_system_id = ss.source_system_id
     AND c.source_customer_key
         LIKE ss.key_prefix || ':CUSTOMER:%'
),

current_address AS (
    SELECT DISTINCT ON (ca.customer_id)
        ca.customer_id,
        ca.city,
        ca.state,
        ca.postal_code,
        BTRIM(ca.country_code)::varchar(2) AS country_code
    FROM oltp.customer_address ca
    JOIN customer_base cb
      ON cb.customer_id = ca.customer_id
    WHERE ca.valid_to IS NULL
    ORDER BY
        ca.customer_id,
        ca.valid_from DESC NULLS LAST,
        ca.address_id DESC
),

current_financial AS (
    SELECT DISTINCT ON (fp.customer_id)
        fp.customer_id,
        fp.yearly_income,
        fp.total_debt,
        fp.fico_score,
        fp.reported_num_cards
    FROM oltp.customer_financial_profile fp
    JOIN customer_base cb
      ON cb.customer_id = fp.customer_id
    WHERE fp.end_date IS NULL
    ORDER BY
        fp.customer_id,
        fp.effective_date DESC,
        fp.profile_id DESC
),

card_count AS (
    SELECT
        c.customer_id,
        COUNT(*)::smallint AS cards_count
    FROM oltp.card c
    JOIN customer_base cb
      ON cb.customer_id = c.customer_id
    GROUP BY c.customer_id
)

SELECT
    cb.source_system_code::varchar(30)
        AS source_system_code,

    cb.source_customer_key::varchar(100)
        AS source_customer_key,

    cb.full_name::varchar(200)
        AS full_name,

    cb.first_name::varchar(100)
        AS first_name,

    cb.last_name::varchar(100)
        AS last_name,

    cb.gender::varchar(30)
        AS gender,

    (
        EXTRACT(
            YEAR FROM AGE(
                cb.transaction_date_to,
                make_date(
                    cb.birth_year,
                    cb.birth_month,
                    1
                )
            )
        )
    )::smallint
        AS current_age,

    cb.retirement_age::smallint
        AS retirement_age,

    cb.birth_year::smallint
        AS birth_year,

    cb.birth_month::smallint
        AS birth_month,

    ca.city::varchar(120)
        AS city,

    ca.state::varchar(30)
        AS state_code,

    ca.postal_code::varchar(30)
        AS postal_code,

    ca.country_code::varchar(2)
        AS country_code,

    cf.yearly_income
        AS annual_income,

    cf.total_debt
        AS total_debt,

    cf.fico_score::smallint
        AS credit_score,

    COALESCE(
        cc.cards_count,
        cf.reported_num_cards,
        0
    )::smallint
        AS cards_count,

    TRUE AS active_flag

FROM customer_base cb

LEFT JOIN current_address ca
  ON ca.customer_id = cb.customer_id

LEFT JOIN current_financial cf
  ON cf.customer_id = cb.customer_id

LEFT JOIN card_count cc
  ON cc.customer_id = cb.customer_id

ORDER BY cb.source_customer_key;</sql>
