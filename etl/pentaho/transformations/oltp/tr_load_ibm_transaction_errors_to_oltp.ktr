    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>cards_oltp</connection>
    <sql>WITH source_errors AS (
    SELECT
        f.file_hash_sha256
            || ':'
            || t.source_row_number::text
            AS source_transaction_key,

        BTRIM(e.error_text) AS source_error_pattern

    FROM stg.ibm_transactions_raw t

    JOIN ctl.etl_file f
      ON f.etl_file_id = t.etl_file_id

    CROSS JOIN LATERAL unnest(
        string_to_array(t.errors_raw, ',')
    ) AS e(error_text)

    WHERE t.etl_file_id = 4
      AND NULLIF(BTRIM(t.errors_raw), '') IS NOT NULL
)

SELECT
    ct.transaction_id,
    ec.error_id,

    /*
        Conservamos el texto individual proveniente de la fuente
        como detalle trazable.
    */
    se.source_error_pattern AS error_detail

FROM source_errors se

JOIN oltp.card_transaction ct
  ON ct.source_system_id = 1
 AND ct.source_transaction_key = se.source_transaction_key

JOIN ctl.source_error_mapping m
  ON m.source_system_code = 'IBM_CORE'
 AND m.source_error_pattern = se.source_error_pattern
 AND m.active_flag = TRUE

JOIN oltp.error_catalog ec
  ON ec.error_code = m.response_code
 AND ec.active_flag = TRUE

/*
    Permite volver a ejecutar la transformación sin violar la PK
    (transaction_id, error_id).
*/
WHERE NOT EXISTS (
    SELECT 1
    FROM oltp.transaction_error te
    WHERE te.transaction_id = ct.transaction_id
      AND te.error_id = ec.error_id
);</sql>
