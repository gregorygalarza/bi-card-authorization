  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>cards_oltp</connection>
    <sql>WITH src AS (
    SELECT
        BTRIM(merchant_name_raw) AS merchant_key,

        UPPER(
            COALESCE(NULLIF(BTRIM(merchant_city), ''), 'UNKNOWN')
        ) AS city_norm,

        UPPER(
            COALESCE(NULLIF(BTRIM(merchant_state), ''), '')
        ) AS state_norm,

        COALESCE(
            NULLIF(
                regexp_replace(BTRIM(merchant_zip_raw), '\.0$', ''),
                ''
            ),
            ''
        ) AS postal_norm,

        MIN(NULLIF(BTRIM(merchant_city), '')) AS city_original

    FROM stg.ibm_transactions_raw
    WHERE etl_file_id = 4

    GROUP BY
        BTRIM(merchant_name_raw),
        UPPER(COALESCE(NULLIF(BTRIM(merchant_city), ''), 'UNKNOWN')),
        UPPER(COALESCE(NULLIF(BTRIM(merchant_state), ''), '')),
        COALESCE(
            NULLIF(
                regexp_replace(BTRIM(merchant_zip_raw), '\.0$', ''),
                ''
            ),
            ''
        )
),

prepared AS (
    SELECT
        s.*,

        concat_ws(
            '|',
            s.merchant_key,
            s.city_norm,
            s.state_norm,
            s.postal_norm
        ) AS location_seed

    FROM src s
),

classified AS (
    SELECT
        p.*,

        CASE
            -- Sin geografía informada: principalmente ONLINE.
            WHEN p.state_norm = ''
                THEN 'ZZ'::char(2)

            -- Código territorial estadounidense.
            WHEN EXISTS (
                SELECT 1
                FROM ctl.us_state_code u
                WHERE u.state_code = p.state_norm
            )
                THEN 'US'::char(2)

            -- Nombre de país que coincide directamente con catálogo.
            -- Si no coincide, resolver mediante alias IBM.
            ELSE COALESCE(
                c.country_code,
                a.country_code
            )
        END AS country_code,

        CASE
            WHEN EXISTS (
                SELECT 1
                FROM ctl.us_state_code u
                WHERE u.state_code = p.state_norm
            )
                THEN p.state_norm
            ELSE NULL
        END::varchar(10) AS region_code

    FROM prepared p

    LEFT JOIN oltp.country c
      ON UPPER(c.country_name) = p.state_norm

    LEFT JOIN ctl.country_name_alias a
      ON a.source_system = 'IBM_CORE'
     AND UPPER(a.source_country_name) = p.state_norm
)

SELECT
    m.merchant_id,

    (
        'IBM_LOCATION:' ||
        ctl.fn_sha256_hex(c.location_seed)
    )::varchar(250) AS source_location_key,

    c.country_code,

    CASE
        WHEN c.city_norm = 'UNKNOWN' THEN NULL
        ELSE COALESCE(c.city_original, c.city_norm)
    END::varchar(100) AS city,

    c.region_code,

    NULLIF(c.postal_norm, '')::varchar(30) AS postal_code,

    NULL::numeric AS latitude,
    NULL::numeric AS longitude,

    TRUE AS active_flag

FROM classified c

JOIN oltp.merchant m
    ON m.source_system_id = 1
   AND m.source_merchant_key =
       'IBM_MERCHANT:' || c.merchant_key

ORDER BY
    m.merchant_id,
    source_location_key;</sql>
