    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>cards_oltp</connection>
    <sql>WITH params AS (
    SELECT
        MAX(
            CASE
                WHEN parameter_code = 'BASE_DECLINE_PERCENT'
                THEN parameter_value::int
            END
        ) AS base_decline_percent,

        MAX(
            CASE
                WHEN parameter_code = 'FRAUD_DECLINE_PERCENT'
                THEN parameter_value::int
            END
        ) AS fraud_decline_percent,

        MAX(
            CASE
                WHEN parameter_code = 'INTERNATIONAL_DECLINE_PERCENT'
                THEN parameter_value::int
            END
        ) AS international_decline_percent,

        MAX(
            CASE
                WHEN parameter_code = 'RULESET_VERSION'
                THEN parameter_value::int
            END
        ) AS ruleset_version

    FROM ctl.integration_parameter
),

distinct_errors AS (
    SELECT DISTINCT
        BTRIM(errors_raw) AS errors_raw

    FROM stg.ibm_transactions_raw

    WHERE etl_file_id = 4
      AND NULLIF(BTRIM(errors_raw), '') IS NOT NULL
),

resolved_errors AS (
    SELECT
        d.errors_raw,
        x.target_status_code,
        x.target_decline_reason_code,
        x.response_code

    FROM distinct_errors d

    LEFT JOIN LATERAL (
        SELECT
            m.target_status_code,
            m.target_decline_reason_code,
            m.response_code

        FROM unnest(
            string_to_array(d.errors_raw, ',')
        ) AS e(error_text)

        JOIN ctl.source_error_mapping m
          ON m.source_system_code = 'IBM_CORE'
         AND m.active_flag = TRUE
         AND m.source_error_pattern = BTRIM(e.error_text)

        ORDER BY m.priority
        LIMIT 1
    ) x ON TRUE
),

base AS (
    SELECT
        t.*,

        f.file_hash_sha256
            || ':'
            || t.source_row_number::text
            AS source_transaction_key,

        NULLIF(
            regexp_replace(
                BTRIM(t.amount_raw),
                '[$,]',
                '',
                'g'
            ),
            ''
        )::numeric AS amount_num,

        CASE UPPER(BTRIM(t.is_fraud_raw))
            WHEN 'YES' THEN TRUE
            ELSE FALSE
        END AS fraud_flag_num,

        CASE BTRIM(t.use_chip_raw)
            WHEN 'Swipe Transaction'  THEN 'SWIPE'
            WHEN 'Chip Transaction'   THEN 'CHIP'
            WHEN 'Online Transaction' THEN 'ONLINE'
            ELSE NULLIF(BTRIM(t.use_chip_raw), '')
        END::varchar(50) AS entry_mode_norm,

        concat_ws(
            '|',
            BTRIM(t.merchant_name_raw),
            UPPER(
                COALESCE(
                    NULLIF(BTRIM(t.merchant_city), ''),
                    'UNKNOWN'
                )
            ),
            UPPER(
                COALESCE(
                    NULLIF(BTRIM(t.merchant_state), ''),
                    ''
                )
            ),
            COALESCE(
                NULLIF(
                    regexp_replace(
                        BTRIM(t.merchant_zip_raw),
                        '\.0$',
                        ''
                    ),
                    ''
                ),
                ''
            )
        ) AS location_seed,

        make_timestamptz(
            t.transaction_year::int,
            t.transaction_month::int,
            t.transaction_day::int,
            split_part(t.transaction_time_raw, ':', 1)::int,
            split_part(t.transaction_time_raw, ':', 2)::int,
            0,
            'UTC'
        ) AS transaction_datetime_norm

    FROM stg.ibm_transactions_raw t

    JOIN ctl.etl_file f
      ON f.etl_file_id = t.etl_file_id

    WHERE t.etl_file_id = 4

      AND NULLIF(
          regexp_replace(
              BTRIM(t.amount_raw),
              '[$,]',
              '',
              'g'
          ),
          ''
      )::numeric &lt;&gt; 0

      AND NOT EXISTS (
          SELECT 1
          FROM oltp.card_transaction ct
          WHERE ct.source_system_id = 1
            AND ct.source_transaction_key =
                f.file_hash_sha256
                || ':'
                || t.source_row_number::text
      )
),

enriched AS (
    SELECT
        b.*,

        c.card_id,
        c.credit_limit,
        c.issuer_country_code,

        ml.location_id AS merchant_location_id,
        ml.country_code AS merchant_country_code,

        mc.category_id,

        r.target_status_code
            AS mapped_status_code,

        r.target_decline_reason_code
            AS mapped_decline_reason_code,

        r.response_code
            AS mapped_response_code,

        (
            NULLIF(BTRIM(b.errors_raw), '') IS NOT NULL
        ) AS error_flag_num

    FROM base b

    JOIN oltp.card c
      ON c.source_system_id = 1
     AND c.source_card_key =
         'IBM_CARD:'
         || BTRIM(b.source_user_id)
         || ':'
         || BTRIM(b.card_index)

    JOIN oltp.merchant m
      ON m.source_system_id = 1
     AND m.source_merchant_key =
         'IBM_MERCHANT:'
         || BTRIM(b.merchant_name_raw)

    JOIN oltp.merchant_location ml
      ON ml.merchant_id = m.merchant_id
     AND ml.source_location_key =
         'IBM_LOCATION:'
         || ctl.fn_sha256_hex(b.location_seed)

    JOIN oltp.merchant_category mc
      ON mc.category_scheme = 'MCC'
     AND mc.category_code = BTRIM(b.mcc_raw)

    LEFT JOIN resolved_errors r
      ON r.errors_raw = BTRIM(b.errors_raw)
),

rules AS (
    SELECT
        e.*,

        -- ----------------------------------------------------
        -- Estado de autorización
        -- ----------------------------------------------------
        CASE
            WHEN e.amount_num &lt; 0
                THEN 'REVERSED'

            WHEN e.mapped_status_code = 'ERROR'
                THEN 'ERROR'

            WHEN e.mapped_status_code = 'DECLINED'
                THEN 'DECLINED'

            WHEN e.error_flag_num
                 AND e.mapped_status_code IS NULL
                THEN 'ERROR'

            WHEN e.credit_limit IS NOT NULL
                 AND e.amount_num > e.credit_limit
                THEN 'DECLINED'

            WHEN e.fraud_flag_num
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|FRAUD|v'
                     || p.ruleset_version
                 ) &lt; p.fraud_decline_percent
                THEN 'DECLINED'

            -- Internacional solo cuando ambos países son conocidos.
            WHEN e.issuer_country_code &lt;&gt; 'ZZ'
                 AND e.merchant_country_code &lt;&gt; 'ZZ'
                 AND e.issuer_country_code &lt;&gt; e.merchant_country_code
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|INTL|v'
                     || p.ruleset_version
                 ) &lt; p.international_decline_percent
                THEN 'DECLINED'

            WHEN ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|BASE|v'
                     || p.ruleset_version
                 ) &lt; p.base_decline_percent
                THEN 'DECLINED'

            ELSE 'APPROVED'
        END AS status_code,

        -- ----------------------------------------------------
        -- Motivo de denegación
        -- ----------------------------------------------------
        CASE
            WHEN e.amount_num &lt; 0
                THEN NULL

            WHEN e.mapped_status_code = 'ERROR'
                THEN NULL

            WHEN e.mapped_status_code = 'DECLINED'
                THEN e.mapped_decline_reason_code

            WHEN e.error_flag_num
                 AND e.mapped_status_code IS NULL
                THEN NULL

            WHEN e.credit_limit IS NOT NULL
                 AND e.amount_num > e.credit_limit
                THEN 'CREDIT_LIMIT_EXCEEDED'

            WHEN e.fraud_flag_num
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|FRAUD|v'
                     || p.ruleset_version
                 ) &lt; p.fraud_decline_percent
                THEN 'SUSPECTED_FRAUD'

            -- Internacional solo cuando ambos países son conocidos.
            WHEN e.issuer_country_code &lt;&gt; 'ZZ'
                 AND e.merchant_country_code &lt;&gt; 'ZZ'
                 AND e.issuer_country_code &lt;&gt; e.merchant_country_code
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|INTL|v'
                     || p.ruleset_version
                 ) &lt; p.international_decline_percent
                THEN 'INTERNATIONAL_NOT_ALLOWED'

            WHEN ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|BASE|v'
                     || p.ruleset_version
                 ) &lt; p.base_decline_percent
                THEN 'DO_NOT_HONOR'

            ELSE NULL
        END AS decline_reason_code,

        -- ----------------------------------------------------
        -- Código de respuesta de autorización
        -- ----------------------------------------------------
        CASE
            WHEN e.amount_num &lt; 0
                THEN 'REVERSED'

            WHEN e.mapped_status_code IS NOT NULL
                THEN e.mapped_response_code

            WHEN e.error_flag_num
                THEN 'UNMAPPED_ERROR'

            WHEN e.credit_limit IS NOT NULL
                 AND e.amount_num > e.credit_limit
                THEN 'CREDIT_LIMIT_EXCEEDED'

            WHEN e.fraud_flag_num
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|FRAUD|v'
                     || p.ruleset_version
                 ) &lt; p.fraud_decline_percent
                THEN 'SUSPECTED_FRAUD'

            -- Internacional solo cuando ambos países son conocidos.
            WHEN e.issuer_country_code &lt;&gt; 'ZZ'
                 AND e.merchant_country_code &lt;&gt; 'ZZ'
                 AND e.issuer_country_code &lt;&gt; e.merchant_country_code
                 AND ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|INTL|v'
                     || p.ruleset_version
                 ) &lt; p.international_decline_percent
                THEN 'INTERNATIONAL_NOT_ALLOWED'

            WHEN ctl.fn_bucket_100(
                     e.source_transaction_key
                     || '|BASE|v'
                     || p.ruleset_version
                 ) &lt; p.base_decline_percent
                THEN 'DO_NOT_HONOR'

            ELSE 'APPROVED'
        END AS response_code

    FROM enriched e
    CROSS JOIN params p
)

SELECT
    1::smallint AS source_system_id,

    r.source_transaction_key,

    r.card_id,

    r.merchant_location_id,

    r.category_id,

    s.authorization_status_id,

    dr.decline_reason_id,

    r.transaction_datetime_norm
        AS transaction_datetime,

    r.amount_num
        AS amount,

    r.entry_mode_norm
        AS entry_mode,

    r.response_code::varchar(30)
        AS authorization_response_code,

    r.error_flag_num
        AS error_flag,

    r.fraud_flag_num
        AS fraud_flag

FROM rules r

JOIN oltp.authorization_status s
  ON s.status_code = r.status_code

LEFT JOIN oltp.decline_reason dr
  ON dr.reason_code = r.decline_reason_code;</sql>
