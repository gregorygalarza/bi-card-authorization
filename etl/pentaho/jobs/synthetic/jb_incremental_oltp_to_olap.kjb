      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>288</xloc>
      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>99-mark_olap_batch_failed</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE ctl.etl_batch b
SET
    status = 'FAILED',
    end_ts = CURRENT_TIMESTAMP,
    rows_rejected = COALESCE(rows_rejected, 0),
    error_message =
        'Fallo en jb_incremental_oltp_to_olap. Revisar log de Pentaho PDI.'
FROM ctl.synthetic_dataset d
WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
  AND d.olap_last_batch_id = b.batch_id
  AND b.status = 'RUNNING';</sql>
