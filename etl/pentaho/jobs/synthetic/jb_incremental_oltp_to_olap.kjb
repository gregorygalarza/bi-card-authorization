    <entry>
      <name>05-preflight_fact</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
DECLARE
    v_set_code              text := UPPER(BTRIM('${P_SET_CODE}'));
    v_source_system_code    text;
    v_source_system_id      smallint;
    v_key_prefix            text;
    v_target_transactions   bigint;

    v_actual                bigint;
BEGIN

    SELECT
        d.source_system_code,
        ss.source_system_id,
        d.key_prefix,
        d.target_transactions
    INTO
        v_source_system_code,
        v_source_system_id,
        v_key_prefix,
        v_target_transactions
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = v_set_code
      AND d.oltp_status = 'VALIDATED'
      AND d.olap_status = 'LOADING';

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'Dataset % no está en VALIDATED/LOADING',
            v_set_code;
    END IF;


    -- source transactions
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%';

    IF v_actual &lt;&gt; v_target_transactions THEN
        RAISE EXCEPTION
            'Source transactions: esperado %, encontrado %',
            v_target_transactions,
            v_actual;
    END IF;


    -- existing facts: must be zero
    SELECT COUNT(*)
    INTO v_actual
    FROM olap.fact_transaction f
    WHERE f.source_system_code = v_source_system_code
      AND f.source_transaction_key
          LIKE v_key_prefix || ':TX:%';

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Ya existen % facts para %',
            v_actual,
            v_set_code;
    END IF;


    -- missing dates
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    LEFT JOIN olap.dim_date dd
      ON dd.full_date =
         (t.transaction_datetime AT TIME ZONE 'UTC')::date
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND dd.date_key IS NULL;

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Missing date keys: %', v_actual;
    END IF;


    -- missing customer
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    JOIN oltp.card c
      ON c.card_id = t.card_id
    JOIN oltp.customer cu
      ON cu.customer_id = c.customer_id
    LEFT JOIN olap.dim_customer dc
      ON dc.source_system_code = v_source_system_code
     AND dc.source_customer_key = cu.source_customer_key
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND dc.customer_key IS NULL;

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Missing customer keys: %', v_actual;
    END IF;


    -- missing card
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    JOIN oltp.card c
      ON c.card_id = t.card_id
    LEFT JOIN olap.dim_card dc
      ON dc.source_system_code = v_source_system_code
     AND dc.source_card_key = c.source_card_key
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND dc.card_key IS NULL;

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Missing card keys: %', v_actual;
    END IF;


    -- missing merchant/location
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    JOIN oltp.merchant_location ml
      ON ml.location_id = t.merchant_location_id
    JOIN oltp.merchant m
      ON m.merchant_id = ml.merchant_id
    LEFT JOIN olap.dim_merchant dm
      ON dm.source_system_code = v_source_system_code
     AND dm.source_merchant_key = m.source_merchant_key
    LEFT JOIN olap.dim_merchant_location dml
      ON dml.source_system_code = v_source_system_code
     AND dml.source_location_key = ml.source_location_key
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND (
          dm.merchant_key IS NULL
          OR dml.merchant_location_key IS NULL
      );

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Missing merchant/location keys: %',
            v_actual;
    END IF;


    -- missing MCC
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    JOIN oltp.merchant_category mc
      ON mc.category_id = t.category_id
    LEFT JOIN olap.dim_merchant_category dmc
      ON dmc.category_scheme = mc.category_scheme
     AND dmc.mcc_code = mc.category_code
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND dmc.merchant_category_key IS NULL;

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Missing MCC keys: %', v_actual;
    END IF;


    -- status
    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    JOIN oltp.authorization_status s
      ON s.authorization_status_id =
         t.authorization_status_id
    LEFT JOIN olap.dim_authorization_status ds
      ON ds.status_code = s.status_code
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND ds.authorization_status_key IS NULL;

    IF v_actual &lt;&gt; 0 THEN
        RAISE EXCEPTION 'Missing status keys: %', v_actual;
    END IF;


    RAISE NOTICE
        'PREFLIGHT FACT OK: set=%, transactions=%',
        v_set_code,
        v_target_transactions;

END
$$;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>cards_oltp</connection>
