      <suppress_result_data>N</suppress_result_data>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>P_SET_CODE</name>
          <stream_name/>
          <value>${P_SET_CODE}</value>
        </parameter>
      </parameters>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>784</xloc>
      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>07-validate_olap</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
DECLARE
    v_set_code              text := UPPER(BTRIM('${P_SET_CODE}'));
    v_source_system_code    text;
    v_source_system_id      smallint;
    v_key_prefix            text;
    v_target_transactions   bigint;

    v_oltp_count            bigint;
    v_olap_count            bigint;

    v_oltp_amount           numeric(30,2);
    v_olap_amount           numeric(30,2);

    v_oltp_declined         bigint;
    v_olap_declined         bigint;

    v_oltp_error_flag       bigint;
    v_olap_error_flag       bigint;

    v_oltp_fraud_flag       bigint;
    v_olap_fraud_flag       bigint;

    v_oltp_intl             bigint;
    v_olap_intl             bigint;

    v_oltp_intl_declined    bigint;
    v_olap_intl_declined    bigint;

    v_ibm_facts             bigint;
BEGIN

    SELECT
        d.source_system_code,
        ss.source_system_id,
        d.key_prefix,
        d.target_transactions
    INTO
        v_source_system_code,
        v_source_system_id,
        v_key_prefix,
        v_target_transactions
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = v_set_code
      AND d.oltp_status = 'VALIDATED'
      AND d.olap_status = 'LOADING';

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'Dataset % no está en VALIDATED/LOADING',
            v_set_code;
    END IF;


    SELECT
        COUNT(*),
        ROUND(SUM(t.amount),2),
        COUNT(*) FILTER (
            WHERE aus.status_code = 'DECLINED'
        ),
        COUNT(*) FILTER (
            WHERE t.error_flag
        ),
        COUNT(*) FILTER (
            WHERE t.fraud_flag
        ),
        COUNT(*) FILTER (
            WHERE c.issuer_country_code &lt;&gt; ml.country_code
              AND c.issuer_country_code &lt;&gt; 'ZZ'
              AND ml.country_code &lt;&gt; 'ZZ'
        ),
        COUNT(*) FILTER (
            WHERE c.issuer_country_code &lt;&gt; ml.country_code
              AND c.issuer_country_code &lt;&gt; 'ZZ'
              AND ml.country_code &lt;&gt; 'ZZ'
              AND aus.status_code = 'DECLINED'
        )
    INTO
        v_oltp_count,
        v_oltp_amount,
        v_oltp_declined,
        v_oltp_error_flag,
        v_oltp_fraud_flag,
        v_oltp_intl,
        v_oltp_intl_declined
    FROM oltp.card_transaction t
    JOIN oltp.card c
      ON c.card_id = t.card_id
    JOIN oltp.merchant_location ml
      ON ml.location_id = t.merchant_location_id
    JOIN oltp.authorization_status aus
      ON aus.authorization_status_id =
         t.authorization_status_id
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%';


    SELECT
        COUNT(*),
        ROUND(SUM(f.amount),2),
        COUNT(*) FILTER (
            WHERE f.declined_flag
        ),
        COUNT(*) FILTER (
            WHERE f.error_flag
        ),
        COUNT(*) FILTER (
            WHERE f.fraud_flag
        ),
        COUNT(*) FILTER (
            WHERE f.international_flag IS TRUE
        ),
        COUNT(*) FILTER (
            WHERE f.international_flag IS TRUE
              AND f.declined_flag
        )
    INTO
        v_olap_count,
        v_olap_amount,
        v_olap_declined,
        v_olap_error_flag,
        v_olap_fraud_flag,
        v_olap_intl,
        v_olap_intl_declined
    FROM olap.fact_transaction f
    WHERE f.source_system_code = v_source_system_code
      AND f.source_transaction_key
          LIKE v_key_prefix || ':TX:%';


    IF v_oltp_count &lt;&gt; v_target_transactions
       OR v_olap_count &lt;&gt; v_target_transactions
    THEN
        RAISE EXCEPTION
            'Count mismatch. Target %, OLTP %, OLAP %',
            v_target_transactions,
            v_oltp_count,
            v_olap_count;
    END IF;


    IF v_oltp_amount &lt;&gt; v_olap_amount THEN
        RAISE EXCEPTION
            'Amount mismatch. OLTP %, OLAP %',
            v_oltp_amount,
            v_olap_amount;
    END IF;


    IF v_oltp_declined &lt;&gt; v_olap_declined THEN
        RAISE EXCEPTION
            'Declined mismatch. OLTP %, OLAP %',
            v_oltp_declined,
            v_olap_declined;
    END IF;


    IF v_oltp_error_flag &lt;&gt; v_olap_error_flag THEN
        RAISE EXCEPTION
            'error_flag mismatch. OLTP %, OLAP %',
            v_oltp_error_flag,
            v_olap_error_flag;
    END IF;


    IF v_oltp_fraud_flag &lt;&gt; v_olap_fraud_flag THEN
        RAISE EXCEPTION
            'fraud_flag mismatch. OLTP %, OLAP %',
            v_oltp_fraud_flag,
            v_olap_fraud_flag;
    END IF;


    IF v_oltp_intl &lt;&gt; v_olap_intl THEN
        RAISE EXCEPTION
            'International mismatch. OLTP %, OLAP %',
            v_oltp_intl,
            v_olap_intl;
    END IF;


    IF v_oltp_intl_declined &lt;&gt; v_olap_intl_declined THEN
        RAISE EXCEPTION
            'International declined mismatch. OLTP %, OLAP %',
            v_oltp_intl_declined,
            v_olap_intl_declined;
    END IF;


    -- IBM_CORE must remain untouched
    SELECT COUNT(*)
    INTO v_ibm_facts
    FROM olap.fact_transaction
    WHERE source_system_code = 'IBM_CORE';

    IF v_ibm_facts &lt;&gt; 24366687 THEN
        RAISE EXCEPTION
            'IBM_CORE fue modificado. Esperado 24366687, encontrado %',
            v_ibm_facts;
    END IF;


    UPDATE ctl.synthetic_dataset
    SET
        olap_status = 'VALIDATED',
        updated_at = CURRENT_TIMESTAMP
    WHERE set_code = v_set_code
      AND olap_status = 'LOADING';


    RAISE NOTICE
        'VALIDACION OLAP OK: set=%, facts=%, amount=%',
        v_set_code,
        v_olap_count,
        v_olap_amount;

END
$$;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>cards_oltp</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>608</xloc>
      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>08-close_olap_batch</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>WITH cfg AS (
    SELECT
        d.set_code,
        d.source_system_code,
        d.key_prefix,
        d.target_customers,
        d.target_cards,
        d.target_merchants,
        d.target_locations,
        d.target_transactions,
        d.olap_last_batch_id
    FROM ctl.synthetic_dataset d
    JOIN ctl.etl_batch b
      ON b.batch_id = d.olap_last_batch_id
     AND b.status = 'RUNNING'
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'VALIDATED'
      AND d.olap_status = 'VALIDATED'
)

UPDATE ctl.etl_batch b
SET
    status = 'SUCCESS',
    end_ts = CURRENT_TIMESTAMP,

    rows_read =
        cfg.target_transactions,

    rows_loaded =
          cfg.target_customers
        + cfg.target_cards
        + cfg.target_merchants
        + cfg.target_locations
        + cfg.target_transactions,

    rows_rejected = 0,
    error_message = NULL

FROM cfg
WHERE b.batch_id = cfg.olap_last_batch_id

RETURNING
    b.batch_id,
    b.process_name,
    b.source_system,
    b.status,
    b.rows_read,
    b.rows_loaded,
    b.rows_rejected,
    b.start_ts,
    b.end_ts;</sql>
