      <attributes/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>64</xloc>
      <yloc>336</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>09-validate_oltp</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
DECLARE
    v_set_code             text := UPPER(BTRIM('${P_SET_CODE}'));
    v_source_system_id     smallint;
    v_key_prefix           text;

    v_target_customers     bigint;
    v_target_cards         bigint;
    v_target_merchants     bigint;
    v_target_locations     bigint;
    v_target_transactions  bigint;

    v_date_from            date;
    v_date_to              date;
    v_batch_id             bigint;

    v_actual               bigint;
    v_invalid              bigint;
    v_batch_status         text;
BEGIN

    -- --------------------------------------------------------
    -- 1. Contexto del dataset
    -- --------------------------------------------------------

    SELECT
        ss.source_system_id,
        d.key_prefix,
        d.target_customers,
        d.target_cards,
        d.target_merchants,
        d.target_locations,
        d.target_transactions,
        d.transaction_date_from,
        d.transaction_date_to,
        d.oltp_last_batch_id
    INTO
        v_source_system_id,
        v_key_prefix,
        v_target_customers,
        v_target_cards,
        v_target_merchants,
        v_target_locations,
        v_target_transactions,
        v_date_from,
        v_date_to,
        v_batch_id
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    WHERE d.set_code = v_set_code
      AND d.oltp_status = 'LOADING'
      AND d.olap_status = 'PENDING';

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'Dataset % no existe o no está en LOADING/PENDING',
            v_set_code;
    END IF;


    -- --------------------------------------------------------
    -- 2. Batch
    -- --------------------------------------------------------

    SELECT status
    INTO v_batch_status
    FROM ctl.etl_batch
    WHERE batch_id = v_batch_id;

    IF v_batch_status IS DISTINCT FROM 'RUNNING' THEN
        RAISE EXCEPTION
            'Batch % debe estar RUNNING. Estado actual=%',
            v_batch_id,
            v_batch_status;
    END IF;


    -- --------------------------------------------------------
    -- 3. Customers
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.customer c
    WHERE c.source_system_id = v_source_system_id
      AND c.source_customer_key
          LIKE v_key_prefix || ':CUSTOMER:%';

    IF v_actual &lt;&gt; v_target_customers THEN
        RAISE EXCEPTION
            'Customers: esperado %, encontrado %',
            v_target_customers,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 4. Customer addresses
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.customer_address ca
    JOIN oltp.customer c
      ON c.customer_id = ca.customer_id
    WHERE c.source_system_id = v_source_system_id
      AND c.source_customer_key
          LIKE v_key_prefix || ':CUSTOMER:%';

    IF v_actual &lt;&gt; v_target_customers THEN
        RAISE EXCEPTION
            'Customer addresses: esperado %, encontrado %',
            v_target_customers,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 5. Financial profiles
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.customer_financial_profile fp
    JOIN oltp.customer c
      ON c.customer_id = fp.customer_id
    WHERE c.source_system_id = v_source_system_id
      AND c.source_customer_key
          LIKE v_key_prefix || ':CUSTOMER:%';

    IF v_actual &lt;&gt; v_target_customers THEN
        RAISE EXCEPTION
            'Financial profiles: esperado %, encontrado %',
            v_target_customers,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 6. Cards
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card c
    WHERE c.source_system_id = v_source_system_id
      AND c.source_card_key
          LIKE v_key_prefix || ':CARD:%';

    IF v_actual &lt;&gt; v_target_cards THEN
        RAISE EXCEPTION
            'Cards: esperado %, encontrado %',
            v_target_cards,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 7. Merchants
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.merchant m
    WHERE m.source_system_id = v_source_system_id
      AND m.source_merchant_key
          LIKE v_key_prefix || ':MERCHANT:%';

    IF v_actual &lt;&gt; v_target_merchants THEN
        RAISE EXCEPTION
            'Merchants: esperado %, encontrado %',
            v_target_merchants,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 8. Merchant locations
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.merchant_location ml
    JOIN oltp.merchant m
      ON m.merchant_id = ml.merchant_id
    WHERE m.source_system_id = v_source_system_id
      AND m.source_merchant_key
          LIKE v_key_prefix || ':MERCHANT:%';

    IF v_actual &lt;&gt; v_target_locations THEN
        RAISE EXCEPTION
            'Merchant locations: esperado %, encontrado %',
            v_target_locations,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 9. Transactions
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_actual
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%';

    IF v_actual &lt;&gt; v_target_transactions THEN
        RAISE EXCEPTION
            'Transactions: esperado %, encontrado %',
            v_target_transactions,
            v_actual;
    END IF;


    -- --------------------------------------------------------
    -- 10. Unicidad de source_transaction_key
    -- --------------------------------------------------------

    SELECT
        COUNT(*) - COUNT(DISTINCT t.source_transaction_key)
    INTO v_invalid
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%';

    IF v_invalid &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Se encontraron % source_transaction_key duplicadas',
            v_invalid;
    END IF;


    -- --------------------------------------------------------
    -- 11. Rango temporal
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_invalid
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND (
          (t.transaction_datetime AT TIME ZONE 'UTC')::date
              &lt; v_date_from
          OR
          (t.transaction_datetime AT TIME ZONE 'UTC')::date
              > v_date_to
      );

    IF v_invalid &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Transacciones fuera del periodo configurado: %',
            v_invalid;
    END IF;


    -- --------------------------------------------------------
    -- 12. Semántica DECLINED / decline_reason
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_invalid
    FROM oltp.card_transaction t
    JOIN oltp.authorization_status aus
      ON aus.authorization_status_id =
         t.authorization_status_id
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND (
          (
              aus.status_code = 'DECLINED'
              AND t.decline_reason_id IS NULL
          )
          OR
          (
              aus.status_code &lt;&gt; 'DECLINED'
              AND t.decline_reason_id IS NOT NULL
          )
      );

    IF v_invalid &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Filas inválidas status/decline_reason: %',
            v_invalid;
    END IF;


    -- --------------------------------------------------------
    -- 13. error_flag vs transaction_error
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_invalid
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND t.error_flag IS DISTINCT FROM EXISTS (
          SELECT 1
          FROM oltp.transaction_error te
          WHERE te.transaction_id = t.transaction_id
      );

    IF v_invalid &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Filas inconsistentes error_flag/transaction_error: %',
            v_invalid;
    END IF;


    -- --------------------------------------------------------
    -- 14. Monto cero
    -- --------------------------------------------------------

    SELECT COUNT(*)
    INTO v_invalid
    FROM oltp.card_transaction t
    WHERE t.source_system_id = v_source_system_id
      AND t.source_transaction_key
          LIKE v_key_prefix || ':TX:%'
      AND t.amount = 0;

    IF v_invalid &lt;&gt; 0 THEN
        RAISE EXCEPTION
            'Transacciones con amount=0: %',
            v_invalid;
    END IF;


    RAISE NOTICE
        'VALIDACION OLTP OK: set=%, batch=%, transactions=%',
        v_set_code,
        v_batch_id,
        v_target_transactions;

END
$$;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>cards_oltp</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>240</xloc>
      <yloc>176</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>10-close_batch</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>WITH cfg AS (
    SELECT
        d.set_code,
        d.source_system_code,
        d.key_prefix,
        d.target_customers,
        d.target_cards,
        d.target_merchants,
        d.target_locations,
        d.target_transactions,
        d.oltp_last_batch_id,
        ss.source_system_id
    FROM ctl.synthetic_dataset d
    JOIN oltp.source_system ss
      ON ss.source_code = d.source_system_code
    JOIN ctl.etl_batch b
      ON b.batch_id = d.oltp_last_batch_id
     AND b.status = 'RUNNING'
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.oltp_status = 'LOADING'
      AND d.olap_status = 'PENDING'
),

err AS (
    SELECT
        COUNT(*) AS error_occurrences
    FROM cfg
    JOIN oltp.card_transaction t
      ON t.source_system_id = cfg.source_system_id
     AND t.source_transaction_key
         LIKE cfg.key_prefix || ':TX:%'
    JOIN oltp.transaction_error te
      ON te.transaction_id = t.transaction_id
),

validated AS (
    UPDATE ctl.synthetic_dataset d
    SET
        oltp_status = 'VALIDATED',
        updated_at = CURRENT_TIMESTAMP
    FROM cfg
    WHERE d.set_code = cfg.set_code
    RETURNING
        d.set_code,
        d.oltp_last_batch_id
)

UPDATE ctl.etl_batch b
SET
    status = 'SUCCESS',
    end_ts = CURRENT_TIMESTAMP,

    rows_read = cfg.target_transactions,

    rows_loaded =
          cfg.target_customers
        + cfg.target_customers
        + cfg.target_customers
        + cfg.target_cards
        + cfg.target_merchants
        + cfg.target_locations
        + cfg.target_transactions
        + err.error_occurrences,

    rows_rejected = 0,
    error_message = NULL

FROM cfg
CROSS JOIN err
JOIN validated v
  ON v.oltp_last_batch_id = cfg.oltp_last_batch_id

WHERE b.batch_id = cfg.oltp_last_batch_id

RETURNING
    b.batch_id,
    b.process_name,
    b.status,
    b.rows_read,
    b.rows_loaded,
    b.rows_rejected,
    b.start_ts,
    b.end_ts;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>cards_oltp</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>64</xloc>
      <yloc>176</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>99-mark_batch_failed</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE ctl.etl_batch b
SET
    status = 'FAILED',
    end_ts = CURRENT_TIMESTAMP,
    rows_rejected = COALESCE(rows_rejected, 0),
    error_message =
        'Fallo en jb_generate_synthetic_set_to_oltp. Revisar log de Pentaho PDI.'
FROM ctl.synthetic_dataset d
WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
  AND d.oltp_last_batch_id = b.batch_id
  AND b.status = 'RUNNING';</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>cards_oltp</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>656</xloc>
      <yloc>480</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>failure</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>784</xloc>
      <yloc>480</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>00-open_batch</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>WITH ds AS (
    SELECT
        d.set_code,
        d.source_system_code,
        d.oltp_status,
        d.olap_status,
        d.oltp_last_batch_id,
        b.status AS previous_batch_status
    FROM ctl.synthetic_dataset d
    LEFT JOIN ctl.etl_batch b
      ON b.batch_id = d.oltp_last_batch_id
    WHERE d.set_code = UPPER(BTRIM('${P_SET_CODE}'))
      AND d.olap_status = 'PENDING'
      AND (
            d.oltp_status = 'PREPARED'
            OR
            (
                d.oltp_status = 'LOADING'
                AND b.status = 'FAILED'
            )
          )
    FOR UPDATE OF d
),

new_batch AS (
    INSERT INTO ctl.etl_batch (
        process_name,
        source_system,
        status
    )
    SELECT
        'GENERATE_SYNTHETIC_SET_TO_OLTP',
        ds.source_system_code,
        'RUNNING'
    FROM ds
    RETURNING batch_id
),

upd AS (
    UPDATE ctl.synthetic_dataset d
    SET
        oltp_status = 'LOADING',
        oltp_last_batch_id = nb.batch_id,
        updated_at = CURRENT_TIMESTAMP
    FROM ds
    CROSS JOIN new_batch nb
    WHERE d.set_code = ds.set_code
    RETURNING
        d.set_code,
        d.oltp_status,
        d.olap_status,
        d.oltp_last_batch_id
)

SELECT
    u.set_code,
    u.oltp_status,
    u.olap_status,
    u.oltp_last_batch_id
FROM upd u;</sql>
